{
  "name": "cornerstone-drafting",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --webpack -p 3002",
    "build": "node -e \"const fs=require('fs'),s=fs.statSync('tsconfig.typecheck.tsbuildinfo',{throwIfNoEntry:false});if(!s||Date.now()-s.mtimeMs>3600000){process.exit(1)}\" && echo 'TypeScript OK (incremental cache fresh)' || node --max-old-space-size=2048 ./node_modules/typescript/bin/tsc --noEmit --skipLibCheck -p tsconfig.typecheck.json",
    "build:next": "next build --webpack",
    "build:analyze": "ANALYZE=true next build --webpack",
    "start": "next start",
    "lint": "eslint app components lib types eslint.config.mjs",
    "typecheck": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "theme:generate": "tsx scripts/generate-theme-css.ts",
    "estate-generator:setup": "python3 -m venv tools/aubreylaw-docgeneration/.venv && tools/aubreylaw-docgeneration/.venv/bin/pip install -r tools/aubreylaw-docgeneration/requirements.txt",
    "prebuild:next": "npm run theme:generate",
    "validate-env": "node scripts/validateEnv.mjs",
    "supabase": "supabase",
    "supabase:status": "supabase status",
    "supabase:db:push": "supabase db push"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@aubrey-law/estate-fields": "file:packages/estate-fields",
    "@aws-sdk/client-s3": "^3.1019.0",
    "@aws-sdk/s3-request-presigner": "^3.1019.0",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-toggle": "1.1.10",
    "@radix-ui/react-tooltip": "1.2.8",
    "@sentry/nextjs": "^10.51.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.100.1",
    "@twilio/voice-sdk": "^2.18.3",
    "archiver": "^7.0.1",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "docx-preview": "^0.4.0",
    "docxtemplater": "^3.68.7",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.9.3",
    "isomorphic-dompurify": "^3.12.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.564.0",
    "mammoth": "^1.12.0",
    "next": "^16.2.6",
    "nunjucks": "^3.2.4",
    "openai": "^4.104.0",
    "pdf-parse": "^2.4.5",
    "pizzip": "^3.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.17.2",
    "sonner": "^1.7.1",
    "tailwind-merge": "^3.3.1",
    "twilio": "^6.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.6",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/archiver": "^7.0.0",
    "@types/node": "^22",
    "@types/nunjucks": "^3.2.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/ui": "^4.1.5",
    "docx": "^9.6.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.6",
    "postcss": "^8.5",
    "supabase": "^2.95.3",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.21.0",
    "tw-animate-css": "1.3.3",
    "typescript": "5.7.3",
    "vitest": "^4.1.5"
  }
}
