{
  "name": "cornerstone-drafting",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "tools/aubreylaw-docgeneration",
    "tools/workflows",
    "tools/matters-mcp"
  ],
  "engines": {
    "node": ">=22 <26"
  },
  "scripts": {
    "dev": "next dev --webpack -p 3002 -H 127.0.0.1",
    "build": "npm run build:next",
    "build:next": "next build --webpack",
    "build:analyze": "ANALYZE=true next build --webpack",
    "start": "next start",
    "lint": "eslint app components hooks lib types packages/citations/src packages/db-types/src packages/drafting-engine/src packages/ui/src tools/matters-mcp/src eslint.config.mjs",
    "typecheck": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "theme:generate": "tsx packages/ui/scripts/generate-theme-css.ts",
    "estate:render": "tsx scripts/render-estate-package.ts",
    "corpus:check": "tsx scripts/corpus.ts",
    "corpus:update": "tsx scripts/corpus.ts --update",
    "corpus:list": "tsx scripts/corpus.ts --list",
    "fixtures:text-layer": "tsx scripts/makeTextLayerFixtures.ts",
    "review:slice": "tsx scripts/reviewSlice.ts",
    "sweep:markers": "tsx scripts/markerSweep.ts",
    "skill:refs": "tsx scripts/generate-doc-template-skill-references.ts",
    "design:forms": "tsx scripts/generate-design-meeting-forms.ts",
    "design:coverage": "tsx scripts/report-design-answer-coverage.ts",
    "clauses:import": "tsx scripts/import-estate-clauses.ts",
    "seed:browser-fixture": "tsx scripts/seedBrowserFixture.ts",
    "build:addin": "cd word-addin && npm ci --include=dev && node scripts/checkDeps.mjs && npm run build",
    "prebuild:next": "npm run theme:generate && npm run build:addin",
    "validate-env": "node scripts/validateEnv.mjs",
    "check:db-rpcs": "node scripts/checkDbRpcs.mjs",
    "check:db-columns": "node scripts/checkDbColumns.mjs",
    "check:migration-drift": "node scripts/checkMigrationDrift.mjs",
    "check:db-types": "node scripts/checkSupabaseTypes.mjs",
    "check:matter-contacts": "tsx scripts/checkMatterContactsConsistency.ts",
    "db:types:linked": "node scripts/generateSupabaseTypes.mjs",
    "db:types:local": "node scripts/generateSupabaseTypes.mjs --local",
    "audit:field-consistency": "tsx scripts/reconcileFieldConsistency.ts",
    "audit:render-matrix": "vitest run tests/draft-preflight.test.ts tests/node-estate-generator.test.ts tests/estate-generator.test.ts tests/derive-documents-practice-area.test.ts",
    "supabase": "supabase",
    "supabase:status": "supabase status",
    "supabase:db:push": "supabase db push",
    "styleSets:seed": "tsx scripts/seedStyleSets.ts",
    "build:ci": "node scripts/ciBuild.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:schema": "vitest run --config vitest.schema.config.ts",
    "check:engagement-anchors": "vitest run --config vitest.probe.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@aubrey-law/citations": "*",
    "@aubrey-law/db-types": "*",
    "@aubrey-law/drafting-engine": "*",
    "@aubrey-law/estate-fields": "*",
    "@aubrey-law/ui": "*",
    "@aws-sdk/client-s3": "^3.1019.0",
    "@aws-sdk/s3-request-presigner": "^3.1019.0",
    "@firma-dev/sdk": "^0.4.0",
    "@hookform/resolvers": "^5.9.1",
    "@napi-rs/canvas": "0.1.80",
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-context-menu": "2.3.7",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-progress": "1.1.16",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@sentry/nextjs": "^10.51.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.100.1",
    "archiver": "^7.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "docx": "^9.6.1",
    "docx-preview": "^0.4.0",
    "docxtemplater": "^3.68.7",
    "dompurify": "^3.4.12",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.9.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.564.0",
    "mammoth": "^1.12.0",
    "next": "^16.2.6",
    "nunjucks": "^3.2.4",
    "openai": "^4.104.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.4.296",
    "pizzip": "^3.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.86.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.17.2",
    "sonner": "^1.7.1",
    "tailwind-merge": "^3.3.1",
    "telnyx": "^7.10.0",
    "twilio": "^6.0.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.6",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/archiver": "^7.0.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^22",
    "@types/nunjucks": "^3.2.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.6",
    "js-yaml": "4.1.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.18",
    "supabase": "^2.95.3",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.21.0",
    "tw-animate-css": "1.3.3",
    "typescript": "5.7.3",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "postcss": "$postcss"
  }
}
