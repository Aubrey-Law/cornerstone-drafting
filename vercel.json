{
  "buildCommand": "npm run estate-generator:setup && npm run build:next",
  "ignoreCommand": "bash scripts/vercel-should-build.sh",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "github": {
    "silent": true
