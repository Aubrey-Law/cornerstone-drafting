{
  "buildCommand": "npm run build:next",
  "ignoreCommand": "bash scripts/vercel-should-build.sh",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "github": {
    "silent": true
  },
  "crons": [
    {
      "path": "/api/cron/daily-digest",
      "schedule": "0 12 * * 1-5"
    },
    {
      "path": "/api/cron/work-graph-shadow",
      "schedule": "45 11 * * 1-5"
    },
    {
      "path": "/api/cron/sla-task-nudges",
      "schedule": "0 12 * * 1-5"
    },
    {
      "path": "/api/cron/appointment-reminders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/calendar-week-review",
      "schedule": "0 * * * 0"
    },
    {
      "path": "/api/cron/scheduled-emails",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/run-queue",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/workflow-jobs",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/invoice-reminders",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/email-triage",
      "schedule": "30 11 * * 1-5"
    },
    {
      "path": "/api/cron/email-triage",
      "schedule": "15 12 * * 1-5"
    },
    {
      "path": "/api/cron/esign-reconcile",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/lawmatics-calendar",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/automation-rules",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/meeting-transcripts",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/annual-review-outreach",
      "schedule": "20 12 * * 1-5"
    }
  ]
}
