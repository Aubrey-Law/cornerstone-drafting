{
  "name": "cornerstone-word-addin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cornerstone drafting task pane for Microsoft Word",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "start": "node scripts/sideload.mjs",
    "stop": "node scripts/unsideload.mjs",
    "clear-cache": "node scripts/clear-cache.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/office-js": "^1.0.400",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "office-addin-dev-certs": "^2.0.9",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
